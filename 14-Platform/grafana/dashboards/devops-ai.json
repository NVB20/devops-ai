        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (agent) (rate(devops_ai_searches_total[5m])) / ignoring(agent) group_left sum(rate(devops_ai_questions_total{route!=\"other\"}[5m]))",
